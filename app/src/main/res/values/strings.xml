    <string name="credit_osm_body">Map data © OpenStreetMap contributors, available under the Open Database License (ODbL). Map tiles © OpenStreetMap.</string>
    <string name="credit_overpass_title">Overpass API</string>
    <string name="credit_overpass_body">Parking data queried from OpenStreetMap via the Overpass API (overpass-api.de and public mirrors).</string>
    <string name="credit_nominatim_title">Nominatim</string>
    <string name="credit_nominatim_body">Place search powered by Nominatim, using OpenStreetMap data.</string>
    <string name="credit_7timer_title">7Timer!</string>
    <string name="credit_7timer_body">Astronomical weather forecast (ASTRO product) by 7Timer!, based on NOAA/NCEP GFS model output.</string>
    <string name="credit_darksky_title">DarkSkySites</string>
    <string name="credit_darksky_body">Sky quality data (zenith SQM and Bortle class) by DarkSkySites.</string>
    <string name="credit_maplibre_title">MapLibre Native</string>
    <string name="credit_maplibre_body">Map rendering by MapLibre Native for Android (BSD 2-Clause license).</string>

