# Copia questo file in local.properties (NON committarlo: è in .gitignore).
# sdk.dir viene scritto da Android Studio automaticamente.
# sdk.dir=/path/to/Android/sdk

# --- Sorgente qualità del cielo ------------------------------------------------------
# auto      = atlas se skyatlas.baseUrl è impostato, altrimenti darksky se c'è la chiave,
#             altrimenti simulated
# atlas     = World Atlas 2015 (Falchi et al.), tile scaricate su richiesta e tenute offline
# darksky   = API DarkSkySites (richiede chiave)
# simulated = modello semplificato, SOLO per sviluppo
sky.source=auto

# Cartella HTTP(S) che contiene manifest.json e le tile *.bin.gz generate con
# tools/build_sky_tiles.py (es. gli asset di una GitHub Release del repo, che deve essere pubblico).
skyatlas.baseUrl=https://github.com/Hunterfenix/Astroscout/releases/download/sky-atlas-wa2015/

# --- DarkSkySites (inquinamento luminoso) -------------------------------------------
# L'API non ha uno schema pubblico documentato: base URL e path sono configurabili.
# Usato solo con sky.source=darksky (o auto senza atlante). darksky.useSimulated=true
# forza la sorgente simulata (equivale a sky.source=simulated).
darksky.baseUrl=https://www.darkskysites.com/
darksky.path=api/v1/sky-quality
darksky.apiKey=
darksky.useSimulated=false

# --- 7Timer! -------------------------------------------------------------------------
# Si prova HTTPS; se l'handshake TLS fallisce, un interceptor riprova in HTTP
# (cleartext consentito SOLO per 7timer.info via network_security_config.xml).
seventimer.baseUrl=https://www.7timer.info/

# --- OpenStreetMap -------------------------------------------------------------------
# Le policy di Nominatim/Overpass/tile.openstreetmap.org richiedono un User-Agent
# che identifichi l'app; aggiungi un contatto (email o URL) per uso reale.
http.userAgent=AstroScout/0.1 (Android)
# I tile OSM ufficiali non sono pensati per traffico intenso da app: in produzione
# usa un provider (MapTiler, Stadia, server proprio...) e aggiorna qui l'URL.
map.tileUrl=https://tile.openstreetmap.org/{z}/{x}/{y}.png
